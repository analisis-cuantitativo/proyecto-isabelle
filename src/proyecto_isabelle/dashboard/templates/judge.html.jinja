<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>LLM-as-a-judge{% if version is not none %} — v{{ version }}{% endif %}</title>
<style>
  body { font-family: -apple-system, sans-serif; margin: 2rem; background: #fafafa; color: #222; }
  a { color: #0b5fff; text-decoration: none; }
  a:hover { text-decoration: underline; }
  nav { margin-bottom: 1rem; }
  nav a { margin-right: 1rem; }
  table { border-collapse: collapse; margin-bottom: 1.5rem; }
  th, td { text-align: left; padding: 0.4rem 0.8rem; border-bottom: 1px solid #ddd; }
  th { color: #555; font-size: 0.85em; text-transform: uppercase; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  code { background: #f0f0f0; padding: 0 0.25rem; border-radius: 3px; }
  .campaign { background: #fff; border: 1px solid #ddd; border-left: 4px solid #0b5fff; border-radius: 6px; padding: 0.7rem 1rem; margin-bottom: 1.2rem; font-size: 0.92em; }
  .campaign.warn { border-left-color: #e0a100; background: #fffaf0; }
  .campaign .revisions { margin-top: 0.4rem; color: #555; }
  .campaign ul { margin: 0.3rem 0 0; padding-left: 1.2rem; }
  .campaign .flag { color: #a35b00; font-weight: 600; }
  .error { background: #fbe8e8; border: 1px solid #f0b8b8; border-radius: 6px; padding: 0.8rem 1rem; max-width: 900px; }
  .badge { padding: 0.15rem 0.6rem; border-radius: 4px; font-size: 0.85em; white-space: nowrap; }
  .badge.exact_match { background: #c8f0c8; }
  .badge.equivalent_reformulation { background: #d8ecc0; }
  .badge.weaker_than_intended { background: #ffe9a8; }
  .badge.stronger_than_intended { background: #ffd8a8; }
  .badge.different_theorem { background: #f8c8c8; }
  .badge.cannot_determine { background: #e3e3e3; }
  .badge.self { background: #e6dcf5; }
  .bar { display: flex; height: 1.1rem; width: 18rem; border-radius: 3px; overflow: hidden; background: #eee; }
  .bar span { display: block; height: 100%; }
  .bar .exact_match { background: #4caf50; }
  .bar .equivalent_reformulation { background: #9ccc65; }
  .bar .weaker_than_intended { background: #f2c230; }
  .bar .stronger_than_intended { background: #f29b30; }
  .bar .different_theorem { background: #d9534f; }
  .bar .cannot_determine { background: #aaa; }
  .legend { margin: 0 0 1rem; font-size: 0.85em; }
  .legend .badge { margin-right: 0.4rem; }
  .filters { margin: 0.8rem 0; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .filters select, .filters input[type=search] { padding: 0.25rem 0.5rem; }
  .case { background: #fff; border: 1px solid #ddd; border-left: 4px solid #bbb; border-radius: 6px; padding: 0.4rem 1rem; margin-bottom: 0.6rem; }
  .case.flagged { border-left-color: #d9534f; }
  .case.ok { border-left-color: #4caf50; }
  .case summary { cursor: pointer; padding: 0.3rem 0; display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap; }
  .case summary .name { font-weight: 600; }
  .meta { color: #666; font-size: 0.85em; }
  pre.thy { background: #fff; border: 1px solid #e5ddb0; border-radius: 4px; padding: 0.5rem 0.7rem; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.9em; white-space: pre-wrap; word-break: break-word; margin: 0.3rem 0 0.8rem; }
  .math { background: #fff; border: 1px solid #bcd0f5; border-radius: 4px; padding: 0.5rem 0.9rem; white-space: pre-wrap; line-height: 1.5; margin: 0.3rem 0 0.8rem; }
  .reasoning { background: #f6f6fb; border-radius: 4px; padding: 0.5rem 0.9rem; margin: 0.3rem 0 0.8rem; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 1100px) { .grid { grid-template-columns: 1fr; } }
</style>
{% include "_katex.html.jinja" %}
</head>
<body>
<nav><a href="/?{{ version_arg }}">&larr; runs</a><a href="/benchmark?{{ version_arg }}">Benchmark coverage</a><a href="/compare?{{ version_arg }}">Compare models</a><a href="/judge?{{ version_arg }}">LLM-as-a-judge</a><a href="/model-history">Model across campaigns</a></nav>
<h1>LLM-as-a-judge</h1>

{% if not error %}
{% include "_campaign_bar.html.jinja" %}
<form class="filters" method="get">
  {% include "_campaign_select.html.jinja" %}
</form>
{% endif %}

{% if error %}
<div class="error">
  <p>Couldn't load the verified final passes from Supabase:</p>
  <pre>{{ error }}</pre>
</div>
{% elif not rows %}
<p>No judged verdicts{% if version is not none %} for campaign v{{ version }}{% endif %} yet{% if unjudged %} ({{ unjudged }} verified final pass(es) still unjudged &mdash; run <code>scripts/judge_formalizations.py</code>){% endif %}.</p>
{% else %}
<p>Every <em>verified</em> final pass was checked against the exercise's
natural-language statement: does the theory state the theorem that was asked
for, or something easier that still builds clean? Only verdicts for each
run's current final pass are shown.
{% if unjudged %}<strong>{{ unjudged }}</strong> verified final pass(es) in this
campaign have no verdict yet.{% endif %}</p>

<div class="legend">
  {% for c in categories %}<span class="badge {{ c }}">{{ c | replace('_', ' ') }}</span>{% endfor %}
</div>

<table>
<thead><tr><th>Model</th><th>Judged</th><th>Faithful</th><th>Rate</th><th>Breakdown</th></tr></thead>
<tbody>
{% for m in summary %}
<tr>
  <td><a href="#" class="pick-model" data-model="{{ m.model }}">{{ m.label }}</a></td>
  <td class="num">{{ m.judged }}</td>
  <td class="num">{{ m.faithful }}</td>
  <td class="num">{{ '%.0f' % (100 * m.faithful / m.judged) }}%</td>
  <td><div class="bar">
    {% for c in categories %}{% if m.counts[c] %}<span class="{{ c }}" style="width: {{ 100 * m.counts[c] / m.judged }}%" title="{{ c | replace('_', ' ') }}: {{ m.counts[c] }}"></span>{% endif %}{% endfor %}
  </div></td>
</tr>
{% endfor %}
</tbody>
</table>

<div class="filters">
  <label>Model:
    <select id="f-model">
      <option value="">all</option>
      {% for m in summary %}<option value="{{ m.model }}">{{ m.label }}</option>{% endfor %}
    </select>
  </label>
  <label>Category:
    <select id="f-category">
      <option value="">all</option>
      <option value="__not_exact">everything except exact match</option>
      {% for c in categories %}<option value="{{ c }}">{{ c | replace('_', ' ') }}</option>{% endfor %}
    </select>
  </label>
  <label>Verdict:
    <select id="f-faithful">
      <option value="">all</option>
      <option value="0">flagged (not faithful)</option>
      <option value="1">faithful</option>
    </select>
  </label>
  <label><input type="checkbox" id="f-self"> hide self-judged</label>
  <input type="search" id="f-text" placeholder="search exercise or reasoning">
  <span class="meta" id="count"></span>
</div>

<div id="cases">
{% for r in rows %}
<details class="case {{ 'ok' if r.faithful else 'flagged' }}"
  data-model="{{ r.model }}" data-category="{{ r.category }}"
  data-faithful="{{ 1 if r.faithful else 0 }}" data-self="{{ 1 if r.self_judged else 0 }}"
  data-text="{{ (r.exercise_name ~ ' ' ~ r.reasoning) | lower | e }}">
  <summary>
    <span class="name">{{ r.exercise_name }}</span>
    <span class="meta">{{ r.model_label }}</span>
    <span class="badge {{ r.category }}">{{ r.category | replace('_', ' ') }}</span>
    {% if r.self_judged %}<span class="badge self" title="The judge was the same model as the one being judged">self-judged</span>{% endif %}
  </summary>
  <div class="reasoning"><strong>Judge:</strong> {{ r.reasoning }}
    {% if r.issues %}<ul>{% for i in r.issues %}<li>{{ i }}</li>{% endfor %}</ul>{% endif %}
    <div class="meta">judge: <code>{{ r.judge_model }}</code></div>
  </div>
  <div class="grid">
    <div><h4>Natural-language statement</h4><div class="math">{{ r.statement }}</div></div>
    <div><h4>Model's formalization</h4><pre class="thy">{{ r.thy_content }}</pre></div>
  </div>
  <a href="/compare/solution?exercise_id={{ r.exercise_id }}&amp;model={{ r.model | urlencode }}&amp;{{ version_arg }}">all runs for this cell &rarr;</a>
</details>
{% endfor %}
</div>

<script>
  (function () {
    var cases = Array.prototype.slice.call(document.querySelectorAll('#cases .case'));
    var f = {
      model: document.getElementById('f-model'),
      category: document.getElementById('f-category'),
      faithful: document.getElementById('f-faithful'),
      self: document.getElementById('f-self'),
      text: document.getElementById('f-text')
    };
    function apply() {
      var shown = 0, q = f.text.value.trim().toLowerCase();
      cases.forEach(function (el) {
        var d = el.dataset;
        var ok = (!f.model.value || d.model === f.model.value)
          && (!f.category.value
              || (f.category.value === '__not_exact' ? d.category !== 'exact_match' : d.category === f.category.value))
          && (!f.faithful.value || d.faithful === f.faithful.value)
          && (!f.self.checked || d.self === '0')
          && (!q || d.text.indexOf(q) !== -1);
        el.style.display = ok ? '' : 'none';
        if (ok) shown++;
      });
      document.getElementById('count').textContent = shown + ' / ' + cases.length + ' shown';
    }
    Object.keys(f).forEach(function (k) { f[k].addEventListener('input', apply); });
    document.querySelectorAll('.pick-model').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        f.model.value = a.dataset.model;
        apply();
        document.getElementById('cases').scrollIntoView({behavior: 'smooth'});
      });
    });
    apply();
  })();
</script>
{% endif %}
</body>
</html>
