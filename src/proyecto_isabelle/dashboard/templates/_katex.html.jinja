{#
  KaTeX for the natural-language math on a page (exercise statements).

  Opt-in, not page-wide: only elements with class `math` are scanned, so
  nothing else on the page is rewritten. Isabelle code (`.thy`) is never
  touched -- it is full of `$`, `\<forall>` and `\<open>`, which would be
  misread as math -- so `.thy` is also an ignored class inside `.math`, and
  `pre`/`code` are already skipped by auto-render's default ignored tags.

  Include once in <head>. Loaded from a CDN, so the page needs network
  access to render math; without it the raw LaTeX stays readable.
#}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"
  onload="document.querySelectorAll('.math').forEach(function (el) {
    renderMathInElement(el, {
      delimiters: [
        {left: '$$', right: '$$', display: true},
        {left: '\\[', right: '\\]', display: true},
        {left: '\\begin{equation}', right: '\\end{equation}', display: true},
        {left: '\\begin{equation*}', right: '\\end{equation*}', display: true},
        {left: '\\begin{align}', right: '\\end{align}', display: true},
        {left: '\\begin{align*}', right: '\\end{align*}', display: true},
        {left: '$', right: '$', display: false},
        {left: '\\(', right: '\\)', display: false}
      ],
      ignoredClasses: ['thy'],
      throwOnError: false
    });
  });"></script>
